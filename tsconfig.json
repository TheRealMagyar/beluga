{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",     // ← ezt írd a node10 helyett
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",                
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["src/*"],
      "@ika.xyz/sdk": ["vendor/@ika.xyz/sdk/dist/esm"],
      "@ika.xyz/ika-wasm": ["src/renderer/lib/ika-wasm-entry.ts"]
    }
  },
  "include": ["src"]
}